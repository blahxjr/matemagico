{
  "name": "@matemagico/database",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev --name foundation"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0"
  },
  "devDependencies": {
    "prisma": "^6.7.0",
    "typescript": "^5.8.3",
    "vitest": "^3.0.8"
  }
}
