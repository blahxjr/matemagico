{
  "name": "@matemagico/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:db": "vitest run src/auth-login.e2e.test.ts src/auth-session.e2e.test.ts src/membership-create.e2e.test.ts src/membership-activate.e2e.test.ts src/membership-grant.e2e.test.ts",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@matemagico/composition-root": "*",
    "@matemagico/database": "*",
    "@matemagico/logger": "*",
    "@prisma/client": "^6.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
